# PhotoSAM environment configuration
# Copy this file to .env and uncomment the appropriate BACKEND_URL

# ── Local development (FastAPI running on your machine) ────────────────────────
BACKEND_URL=http://localhost:8000

# ── Phase 2: Google Colab + ngrok ─────────────────────────────────────────────
# BACKEND_URL=https://xxxx-xxxx-xxxx.ngrok-free.app

# ── Phase 3: Hugging Face Spaces ──────────────────────────────────────────────
# BACKEND_URL=https://mohdanas-photosam.hf.space

# ── Optional overrides ─────────────────────────────────────────────────────────
# PHOTOSAM_DEVICE=cuda          # Force GPU (default: auto-detect)
# PHOTOSAM_MAX_SIZE=1024        # Max image dimension before resize (default: 1024)
# PHOTOSAM_MAX_UPLOAD_MB=20     # Max upload size in MB (default: 20)
